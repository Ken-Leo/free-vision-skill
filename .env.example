# Free Vision Skill - Environment Configuration
# Copy this file to .env and fill in your API keys

# Provider selection: 'auto' for auto-fallback, or specific provider name
VISION_PROVIDER=auto

# Region: 'cn' for China-first providers, 'global' for global providers
VISION_REGION=cn

# Option 1: Zhipu AI (智谱AI) - China
# Get your key from: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# Option 2: OpenRouter - Global
# Get your key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 3: Custom OpenAI-compatible endpoint
# VISION_BASE_URL=https://your-custom-endpoint.com/v1
# VISION_MODEL=your-model-name
# VISION_API_KEY=your_api_key

# Local cache directory (optional, default: .vision-cache)
# VISION_CACHE_DIR=.vision-cache
