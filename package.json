{
  "name": "free-vision-skill",
  "version": "0.3.0",
  "description": "A low-token visual evidence compiler for text-only coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "lora-sys",
  "repository": {
    "type": "git",
    "url": "https://github.com/lora-sys/free-vision-skill.git"
  },
  "homepage": "https://github.com/lora-sys/free-vision-skill#readme",
  "bugs": {
    "url": "https://github.com/lora-sys/free-vision-skill/issues"
  },
  "keywords": [
    "agent-skill",
    "deepseek",
    "vision",
    "coding-agent",
    "vlm",
    "ocr",
    "visual-evidence",
    "low-token",
    "codex",
    "claude-code",
    "opencode"
  ],
  "files": [
    "dist",
    "registry",
    "hooks",
    "installers",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "free-vision": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "see": "tsx src/cli.ts see",
    "doctor": "tsx src/cli.ts doctor",
    "providers": "tsx src/cli.ts providers",
    "login": "tsx src/cli.ts login",
    "logout": "tsx src/cli.ts logout",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
