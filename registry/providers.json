      "region": "global",
      "kind": "openai",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKeyEnv": "GROQ_API_KEY",
      "models": [
        "qwen/qwen3.6-27b"
      ],
      "defaultModel": "qwen/qwen3.6-27b",
