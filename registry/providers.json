{
  "version": 1,
  "verifiedAt": "2026-08-01",
  "providers": [
    {
      "id": "custom",
      "name": "Custom OpenAI-compatible endpoint (local oMLX)",
      "region": "cn",
      "kind": "openai",
      "baseUrl": "http://127.0.0.1:8000/v1",
      "baseUrlEnv": "VISION_BASE_URL",
      "apiKeyEnv": "VISION_API_KEY",
      "models": [],
      "defaultModel": "",
      "modelEnv": "VISION_MODEL",
      "free": "self-hosted / bring-your-own endpoint",
      "supportsDetail": false,
      "priority": 5,
      "notes": "Local oMLX Qwen or any OpenAI-compatible endpoint. Set VISION_BASE_URL, VISION_MODEL, VISION_API_KEY."
    },
    {
      "id": "zhipu",
      "name": "Zhipu BigModel",
      "region": "cn",
      "kind": "openai",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "apiKeyEnv": "ZHIPU_API_KEY",
      "models": [
        "glm-4.6v-flash",
        "glm-4v-flash"
      ],
      "defaultModel": "glm-4.6v-flash",
      "free": "permanent-free models",
      "supportsDetail": false,
      "priority": 10,
      "notes": "Best default in mainland China. GLM-4.6V-Flash and GLM-4V-Flash are documented free visual models."
    },
    {
      "id": "modelscope",
      "name": "ModelScope API-Inference",
      "region": "cn",
      "kind": "openai",
      "baseUrl": "https://api-inference.modelscope.cn/v1",
      "apiKeyEnv": "MODELSCOPE_API_KEY",
      "models": [
        "Qwen/Qwen3-VL-8B-Instruct",
        "Qwen/Qwen3-VL-8B-Thinking"
      ],
      "defaultModel": "Qwen/Qwen3-VL-8B-Instruct",
      "free": "selected models / quota varies",
      "supportsDetail": false,
      "priority": 20,
      "authPrefix": "",
      "notes": "ModelScope requires token without 'Bearer' prefix in Authorization header. Token format: ms-xxxxx. Verify the model page shows ModelScope Inference before use."
    },
    {
      "id": "siliconflow",
      "name": "SiliconFlow",
      "region": "cn",
      "kind": "openai",
      "baseUrl": "https://api.siliconflow.cn/v1",
      "apiKeyEnv": "SILICONFLOW_API_KEY",
      "models": [],
      "defaultModel": "",
      "modelEnv": "SILICONFLOW_VISION_MODEL",
      "free": "free catalog changes frequently",
      "supportsDetail": true,
      "priority": 30,
      "notes": "No hard-coded model: several older VL model IDs were retired in 2026. Set SILICONFLOW_VISION_MODEL from the live model catalog."
    },
    {
      "id": "alibaba",
      "name": "Alibaba Cloud Model Studio",
      "region": "cn",
      "kind": "openai",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "baseUrlEnv": "ALIBABA_BASE_URL",
      "apiKeyEnv": "DASHSCOPE_API_KEY",
      "models": [
        "qwen3-vl-flash"
      ],
      "defaultModel": "qwen3-vl-flash",
      "free": "new-user quota, China Beijing, 90 days",
      "supportsDetail": false,
      "priority": 40,
      "notes": "Trial rather than permanent free. Workspace-specific Beijing URL may be required for current Qwen-VL deployments."
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "region": "global",
      "kind": "openai",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "models": [
        "nvidia/nemotron-nano-12b-v2-vl:free",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "openrouter/free"
      ],
      "defaultModel": "nvidia/nemotron-nano-12b-v2-vl:free",
      "free": "permanent free variants; shared daily limits",
      "supportsDetail": true,
      "priority": 10,
      "notes": "Use an explicit :free model for predictable behavior. openrouter/free can auto-select an image-capable free model."
    },
    {
      "id": "groq",
